{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Livery AI",
  "identifier": "com.simracecenter.liverai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Livery AI",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "theme": "Dark",
        "backgroundColor": "#05070A"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sim RaceCenter",
    "homepage": "https://simracecenter.com",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "GraphicsAndDesign",
    "shortDescription": "iRacing livery design studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/cars/": "cars/"
    }
  }
}
